---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const projects = [
  {
    title: 'Project One',
    description: 'A short description of what this project does and the problem it solves.',
    tags: ['TypeScript', 'React', 'Node.js'],
    github: 'https://github.com/chiunhau',
    demo: '',
  },
  {
    title: 'Project Two',
    description: 'Another project showcasing different skills and technologies.',
    tags: ['Python', 'FastAPI', 'PostgreSQL'],
    github: 'https://github.com/chiunhau',
    demo: '',
  },
];

const skills = [
  'TypeScript', 'JavaScript', 'Python', 'Go',
  'React', 'Node.js', 'PostgreSQL', 'Docker',
  'Git', 'Linux', 'REST APIs', 'GraphQL',
];
---

<Layout title="Chiunhau You">
  <main>
    <!-- Hero -->
    <div class="container">
      <section class="home-hero">
        <p class="tag">Available for opportunities</p>
        <h1>Hi, I'm <em>Chiunhau You</em></h1>
        <p>
          Software developer who enjoys building clean, thoughtful products.
          I care about good code, good design, and the intersection between them.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn">View my work</a>
          <a href="/blog" class="btn btn-ghost">Read my writing</a>
        </div>
      </section>

      <!-- About -->
      <section id="about" class="home-section">
        <p class="section-label">About</p>
        <h2>A bit about me</h2>
        <p>
          I'm a software developer based wherever my laptop is. I enjoy working across
          the full stack — from designing APIs to crafting interfaces that feel natural
          to use.
        </p>
        <p>
          When I'm not writing code, I'm probably reading, exploring new tools, or
          thinking about systems and how things connect.
        </p>
        <div class="skills-grid">
          {skills.map((skill) => (
            <span class="skill-tag">{skill}</span>
          ))}
        </div>
      </section>

      <!-- Projects -->
      <section id="projects" class="home-section">
        <p class="section-label">Projects</p>
        <h2>Things I've built</h2>
        <p>
          A selection of projects I've worked on — personal experiments, side projects,
          and open-source work.
        </p>
        <div class="projects-grid">
          {projects.map((project) => (
            <div class="project-card">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="project-tag">{tag}</span>
                ))}
              </div>
              <div class="project-links">
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener">GitHub →</a>
                )}
                {project.demo && (
                  <a href={project.demo} target="_blank" rel="noopener">Live →</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Writing -->
      {posts.length > 0 && (
        <section class="home-section">
          <p class="section-label">Writing</p>
          <h2>Recent posts</h2>
          <div class="post-list">
            {posts.map((post) => (
              <a href={`/blog/${post.id}`} class="post-list-item">
                <div class="post-list-date">
                  {post.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
                </div>
                <div>
                  {post.data.tag && <p class="post-list-tag">{post.data.tag}</p>}
                  <p class="post-list-title">{post.data.title}</p>
                  {post.data.subtitle && (
                    <p class="post-list-subtitle">{post.data.subtitle}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
          <p style="margin-top: 24px;">
            <a href="/blog" class="btn btn-ghost" style="display: inline-flex;">All writing →</a>
          </p>
        </section>
      )}

      <!-- Contact -->
      <section id="contact" class="home-section">
        <p class="section-label">Contact</p>
        <h2>Let's talk</h2>
        <p>
          I'm open to new opportunities, collaborations, or just a good conversation.
          Reach out through any of the channels below.
        </p>
        <div class="contact-links">
          <a href="mailto:chiunhau9@gmail.com" class="contact-link">
            <span class="label">Email</span>
            <span class="value">chiunhau9@gmail.com</span>
          </a>
          <a href="https://github.com/chiunhau" target="_blank" rel="noopener" class="contact-link">
            <span class="label">GitHub</span>
            <span class="value">github.com/chiunhau</span>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>
